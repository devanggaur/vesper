# Server port (Vite proxies /api -> http://localhost:8787)
PORT=8787

# Google Gemini API key (Google AI Studio or Vertex AI Express)
GEMINI_API_KEY=your_gemini_api_key

# Google Cloud Places API (New) key (server-side only)
GOOGLE_PLACES_API_KEY=your_google_places_api_key

# Google Maps JavaScript API key (browser-side; restrict by HTTP referrer + Maps JS API)
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_js_api_key

# Supabase project credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Browser-safe Supabase public keys (for optional Supabase Auth)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Optional Phase 3 Live GDS / Hotel APIs (leave blank to use AI-grounded schedules + provider handoff links)
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_BASE_URL=https://test.api.amadeus.com
LITEAPI_KEY=
